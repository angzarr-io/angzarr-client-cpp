# C++ client devcontainer
# Uses custom base image from ghcr.io/angzarr

ARG CPP_IMAGE=ghcr.io/angzarr-io/angzarr-cpp:latest
FROM ${CPP_IMAGE}

# INFRA-1: rootless docker — trust any bind-mounted workspace path so
# `git rev-parse --show-toplevel` inside `just _container` succeeds.
USER root
RUN git config --system --add safe.directory '*' \
 && git config --system --add safe.directory '/workspace' \
 && git config --system --add safe.directory '/angzarr'

# Cyclomatic complexity tooling: lizard (used by `just complexity`).
# lizard is a Python tool; install python3 + pip alongside it. The upstream
# angzarr-cpp base image (built from the missing build/images/Containerfile.cpp-base
# referenced by examples-cpp's build-base-image.yml) does NOT ship lizard, so
# it is baked in here for the devcontainer path. --break-system-packages is
# needed under PEP 668 (Debian/Ubuntu externally-managed environments).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir --break-system-packages lizard

# Mark as devcontainer for justfile detection
ENV DEVCONTAINER=true

# Mutation tooling: mull (runner + compiler frontend).
#
# The base image bakes mull-runner-17 and mull-ir-frontend-17 at:
#   /usr/bin/mull-runner-17           (0.33.0, LLVM 17.0.6)
#   /usr/lib/mull-ir-frontend-17      (compiler-driver wrapper)
#
# Phase E.v2 (2026-05-16) DISCOVERED that the bundled mull-ir-frontend-17
# segfaults on this image (apt list 'mull-17' 0.33.0 + libabsl 20220623 +
# clang-17). This breaks the full-library mutation flow: `mull-runner-17`
# reports "no mutants found" because no IR is embedded in the test binary.
#
# Workaround documented for next image refresh:
#   - Upgrade to mull >= 0.34 OR bisect the segfault against a clean
#     ubuntu:24.04 with apt-installed mull-17.
#   - Verify with: `/usr/lib/mull-ir-frontend-17 --version` (should NOT
#     segfault).
#   - For build-mull, use: `cmake -DCMAKE_CXX_COMPILER=clang++-17 \
#     -DCMAKE_CXX_FLAGS='-g -grecord-command-line -w' -B build-mull \
#     -DCMAKE_CXX_LINK_FLAGS='-Wl,--unresolved-symbols=ignore-all'`.
#
# Documented score (from D-C++ fix-log, 2026-05-16): 85% on scoped
# `mutation_tests_d_cpp` binary (119 killed / 19 survived / 138 mutants).
ARG MULL_VERSION=0.33.0
ENV ANGZARR_MULL_RUNNER=/usr/bin/mull-runner-17
ENV ANGZARR_MULL_IR_FRONTEND=/usr/lib/mull-ir-frontend-17
ENV ANGZARR_MULL_VERSION=${MULL_VERSION}
