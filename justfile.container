# C++ client library - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI container jobs
# Uses system packages for gRPC/protobuf (not vcpkg)

set shell := ["bash", "-c"]

ROOT := `git rev-parse --show-toplevel`

default:
    @just --list

# =============================================================================
# CMake invocation model
# =============================================================================
# All recipes go through `CMakePresets.json` (configure/build/test presets).
# Inline -D flags are forbidden here — adding a flag means editing the
# preset so every recipe + every IDE picks it up consistently. The historic
# bug this fixes: `just build` was running cmake with no -DCMAKE_BUILD_TYPE
# so its first invocation produced a Debug-default cache, while
# `just generate-proto` ran cmake with -DCMAKE_BUILD_TYPE=Release and
# produced a Release cache. Whichever ran first won.
#
# Build dir convention: presets write to `build/container/` (and
# `build/container-mull/` for the mutation preset). Host-side cmake is
# never expected to touch this tree; if you ever see `CMakeCache.txt`
# under a different root, run `just clean` and re-invoke through `just`.

# =============================================================================
# Proto generation — container-side executor.
# =============================================================================
# `just generate-proto` (host-side) is the canonical entrypoint and handles
# the staleness check + container dispatch. Inside the container this recipe
# runs the protoc invocation via CMake's `add_custom_command` rules by
# building the `proto_gen` aggregator target, whose `.pb.{cc,h}/.grpc.pb.{cc,h}`
# prerequisites trigger the custom commands without compiling the library
# or tests. Keeps the regen entrypoint outside the main build graph per
# project_proto_generation_model.
generate-proto-force:
    cmake --preset default
    cmake --build --preset proto-gen

# Legacy in-container alias for proto generation (host-side `just proto`
# routed here historically). Calls the canonical force recipe.
proto: generate-proto-force

configure:
    cmake --preset default

build:
    cmake --preset default
    cmake --build --preset default

test:
    cmake --preset default
    cmake --build --preset default
    ctest --preset default --test-dir build/container

# Format check (clang-format, Google style)
fmt:
    find src include -name "*.cpp" -o -name "*.hpp" | xargs clang-format --dry-run --Werror --style=Google

# Auto-format code
fmt-fix:
    find src include -name "*.cpp" -o -name "*.hpp" | xargs clang-format -i --style=Google

# Run Mull mutation testing on combined test binary
#
# NOTE: Mull mutates compiled LLVM IR, NOT .cpp/.hpp source. The host-side
# `mutation-test` recipe routes through `_container-ephemeral` so the
# build-mull/ tree lives in the container's writable overlay layer and is
# destroyed by `--rm` on exit. If $CCACHE_DIR is set (provided by the
# ephemeral helper as /ccache) and ccache is available, we wire it as the
# compiler launcher to keep mutation iteration fast across runs.
mutation-test:
    #!/usr/bin/env bash
    set -euo pipefail
    MULL=$(command -v mull-runner-17 2>/dev/null || command -v mull-runner 2>/dev/null)
    if [ -z "$MULL" ]; then
        echo "ERROR: mull-runner not found. Use the angzarr-cpp:latest base image."
        exit 1
    fi
    echo "Running Mull mutation testing ($($MULL --version 2>&1 | head -1))..."
    # The `mutation` preset pins clang-17 + the IR-frontend pass plugin
    # + debug info. ccache is wired here (not in the preset) so it's only
    # active when the ephemeral helper provides $CCACHE_DIR — keeps
    # non-ephemeral mutation runs reproducible.
    CCACHE_ARGS=()
    if command -v ccache >/dev/null 2>&1 && [ -n "${CCACHE_DIR:-}" ]; then
        CCACHE_ARGS=(-DCMAKE_C_COMPILER_LAUNCHER=ccache
                     -DCMAKE_CXX_COMPILER_LAUNCHER=ccache)
    fi
    cmake --preset mutation "${CCACHE_ARGS[@]}"
    cmake --build --preset mutation -j$(nproc)
    $MULL --reporters Elements build/container-mull/mutation_tests 2>&1 || true
    echo "Mutation testing complete."

# Create release archive with checksums
archive VERSION:
    cd {{ROOT}} && git archive --format=tar.gz --prefix=angzarr-client-cpp-{{VERSION}}/ -o client/cpp/angzarr-client-cpp-{{VERSION}}.tar.gz HEAD:client/cpp
    sha512sum angzarr-client-cpp-{{VERSION}}.tar.gz > angzarr-client-cpp-{{VERSION}}.tar.gz.sha512

# Cross-language alias — `just check` runs lint + fmt-check.
check: fmt

# Cross-language alias — `just lint` placeholder (C++ uses fmt-check only).
lint: fmt
